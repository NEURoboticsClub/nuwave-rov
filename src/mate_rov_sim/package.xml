<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mate_rov_sim</name>
  <version>0.1.0</version>
  <description>Gazebo Sim simulation of the NUWave MATE ROV (buoyancy, hydrodynamics, 8 thrusters, arm, sensors), driven by the real NUWave nodes.</description>
  <maintainer email="team@example.com">Your MATE team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>joy</exec_depend>

  <!-- NUWave packages the simulator runs or reads configs from -->
  <exec_depend>nuwave_utils_pkg</exec_depend>
  <exec_depend>thruster_pkg</exec_depend>
  <exec_depend>stabilization_pkg</exec_depend>
  <exec_depend>houston_pkg</exec_depend>
  <exec_depend>thruster_controller_pkg</exec_depend>
  <exec_depend>arm_controller_pkg</exec_depend>
  <exec_depend>web_gui_pkg</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
